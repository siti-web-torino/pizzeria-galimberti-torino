# Copia questo file in .env.local (in locale) o imposta le stesse variabili
# su Vercel (Settings -> Environment Variables). Mai committare i valori veri.

# --- Admin -----------------------------------------------------------------
# Password del titolare per entrare in /admin. In produzione il sito NON
# parte se è vuota, se è uguale a questa di esempio o se è sotto 10 caratteri.
ADMIN_PASSWORD="scegli-una-password-lunga"

# Segreto per firmare il cookie di accesso (almeno 32 caratteri).
# Generane uno con:  openssl rand -base64 32
AUTH_SECRET="genera-una-stringa-lunga-e-casuale"

# --- Database (Upstash Redis) ----------------------------------------------
# In locale puoi lasciarle vuote: `npm run dev` salva in .data/store.json.
# In produzione senza queste variabili il sito mostra i dati iniziali e
# l'admin avvisa che le modifiche non verrebbero salvate.
# Con l'integrazione Upstash del marketplace Vercel si impostano da sole.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
